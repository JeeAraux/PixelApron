static func glyph(ch: String) -> Array:
	return GLYPHS.get(ch.to_upper(), GLYPHS["-"])


## Breite eines Textes in Pixeln (mit einem Pixel Abstand zwischen den Zeichen).
static func width(text: String) -> int:
	var w := 0
	for i in range(text.length()):
		w += String(glyph(text[i])[0]).length() + (1 if i < text.length() - 1 else 0)
	return w


## Text als Pixelvierecke. c = Mitte, right = Leserichtung, up = Oberkante der Zeichen,
## normal = Blickrichtung der Fläche. px = Pixelgröße in Metern.
static func draw(k: Kit, text: String, c: Vector3, right: Vector3, up: Vector3, normal: Vector3, px: float, col: Color) -> void:
	var r := right.normalized()
	var u := up.normalized()
	var total := float(width(text)) * px
	var x := -total * 0.5
	for i in range(text.length()):
		var rows: Array = glyph(text[i])
		var gw := String(rows[0]).length()
		for row in range(rows.size()):
			var line: String = rows[row]
			for col_i in range(gw):
				if line[col_i] != "1":
					continue
				var px_c := c + r * (x + (float(col_i) + 0.5) * px) + u * ((3.0 - float(row)) * px)
				k.panel(px_c, r * px * 0.5, u * px * 0.5, col, normal)
		x += float(gw + 1) * px


## Text flach auf dem Boden, lesbar für jemanden, der in Richtung fwd darauf zufährt.
static func draw_ground(k: Kit, text: String, c: Vector3, fwd: Vector3, px: float, col: Color) -> void:
	var f := Vector3(fwd.x, 0.0, fwd.z).normalized()
	var right := f.cross(Vector3.UP).normalized()
	draw(k, text, c, right, f, Vector3.UP, px, col)
